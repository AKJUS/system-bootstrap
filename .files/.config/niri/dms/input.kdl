input {
    mouse {
        accel-speed 0.0
    }
    touchpad {
        tap
        accel-speed 0.0
        natural-scroll
        dwt
    }
    keyboard {
        xkb {
            layout "us,ua"
            options "grp:win_space_toggle"
        }
        track-layout "window"
    }
}


